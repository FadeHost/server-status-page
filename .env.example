# A FadeHost access token with the read scope.
# Profile -> AI Access in the panel: https://laplace.fadehost.com/profile/ai-access
FADEHOST_TOKEN=

# Which servers to show, comma separated. Leave empty to show them all.
SERVER_IDS=

# The heading at the top of the page.
TITLE=Server status

# The port to listen on. FadeHost sets this for you.
PORT=8080
